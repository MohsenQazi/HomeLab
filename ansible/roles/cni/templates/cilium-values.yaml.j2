# to tell Cilium use eBPF instead of kube-proxy
kubeProxyReplacement: true
# without kube-proxy, we must specify how Cilium pods communicate with kube-apiserver
k8sServiceHost: "{{ ansible_host }}" 
k8sServicePort: "6443"

operator:
  replicas: 1

ipam:
  mode: kubernetes

# Hubble gives you `flow-level telemetry`.
hubble:
  enabled: true
  relay:
    enabled: true
  ui:
    enabled: true

ingressController:
  enabled: false
